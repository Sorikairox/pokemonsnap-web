{
  "$schema": "https://retrowser.app/spec/retrowser.schema.json",
  "retrowser": 1,
  "id": "pokemonsnap-us",
  "title": "Pokémon Snap (source port)",
  "platform": "n64",
  "rom": { "sha1": ["edc7c49cc568c045fe48be0d18011c30f393cbaf"] },
  "files": {
    "wasm": { "path": "pokemonsnap.wasm", "sha256": "", "size": 0 },
    "js": { "path": "pokemonsnap.js", "sha256": "", "size": 0, "factory": "createPokemonSnap" },
    "data": [{ "path": "pokemonsnap.romfill", "sha256": "", "size": 0 }]
  },
  "picture": { "path": "cover.png", "sha256": "", "size": 0, "credit": "Box art © Nintendo / HAL Laboratory · image from libretro-thumbnails" },
  "video": "webgl",
  "hz": 60,
  "save": { "kind": "flash", "size": 131072 },
  "controls": {
    "motion": { "when": 3 },
    "extra": [{ "bit": 16, "label": "Snap", "when": 1 }, { "bit": 17, "label": "Shutter" }]
  },
  "options": [
    { "id": 1, "label": "Snap button", "type": "bool", "default": 1, "inGame": true },
    { "id": 2, "label": "Sharp pixels", "type": "bool", "default": 0, "inGame": true },
    { "id": 3, "label": "Motion aim", "type": "bool", "default": 0, "inGame": true },
    { "id": 4, "label": "Mouse aim", "type": "bool", "default": 1, "inGame": true },
    { "id": 5, "label": "Mouse speed", "type": "int", "default": 5, "min": 1, "max": 10, "inGame": true }
  ],
  "license": "MIT",
  "source": "https://github.com/Sorikairox/pokemonsnap-web"
}
